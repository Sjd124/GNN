class SimpleGCNWithPhysics(torch.nn.Module):
    """Simple GCN with basic physics constraints"""

    def __init__(self):
        super().__init__()
        torch.manual_seed(1234)

        # Learnable physics parameter (simplified)
        self.lambda_phys = nn.Parameter(torch.tensor([1.0], dtype=torch.float32))

        # GCN layers
        self.conv1 = GCNConv(11, 7)
        self.conv2 = GCNConv(7, 4)
        self.conv3 = GCNConv(4, 2)
        self.property = nn.Linear(2, 1)

    def forward(self, x, edge_index, batch, concentration):
        """Forward pass with concentration"""
        if concentration.shape[0] == 1:
            batch_size = batch.max().item() + 1
            concentration = concentration.repeat(batch_size, 1)

        conc_expanded = concentration.repeat_interleave(
            torch.bincount(batch), dim=0
        )

        x_combined = torch.cat([x, conc_expanded], dim=1)

        h = torch.relu(self.conv1(x_combined, edge_index))
        h = torch.relu(self.conv2(h, edge_index))
        h = torch.relu(self.conv3(h, edge_index))
        h = global_max_pool(h, batch)
        out = self.property(h)

        return out, h


def get_graph_targets(data):
    """Extract graph-level targets"""
    return data.y.float().view(-1)


def physics_loss(model, x, edge_index, batch, concentration_value):
    """Simplified physics loss"""
    concentration = torch.tensor([[concentration_value]], dtype=torch.float, device=x.device)
    concentration.requires_grad_(True)

    y, _ = model(x, edge_index, batch, concentration)

    # Compute gradient with respect to concentration
    y_c = torch.autograd.grad(
        y, concentration,
        grad_outputs=torch.ones_like(y),
        create_graph=True,
        retain_graph=True
    )[0]


    phys_loss = torch.mean((y_c - model.lambda_phys) ** 2)

    return phys_loss


def train_epoch(loader, model, optimizer, criterion, concentration_value, phys_weight=0.01):
    """Train for one epoch with physics constraint"""
    model.train()
    total_loss = total_data_loss = total_phys_loss = 0.0
    total_graphs = 0

    for batch in loader:
        batch = batch.to(device)
        optimizer.zero_grad()

        concentration_tensor = torch.tensor([[concentration_value]], dtype=torch.float, device=device)

        out, _ = model(batch.x, batch.edge_index, batch.batch, concentration_tensor)
        pred = out.squeeze(-1)
        target = get_graph_targets(batch)

        # Data loss
        data_loss = criterion(pred, target)

        # Physics loss (with small weight)
        phys_loss = physics_loss(
            model, batch.x, batch.edge_index, batch.batch, concentration_value
        )

        # Total loss
        total_loss_batch = data_loss + phys_weight * phys_loss
        total_loss_batch.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
        optimizer.step()

        n = target.numel()
        total_loss += total_loss_batch.item() * n
        total_data_loss += data_loss.item() * n
        total_phys_loss += phys_loss.item() * n
        total_graphs += n

    return (total_loss / total_graphs,
            total_data_loss / total_graphs,
            total_phys_loss / total_graphs)


@torch.no_grad()
def evaluate(loader, model, concentration_value):
    """Evaluate model performance"""
    model.eval()
    all_pred, all_target = [], []
    concentration_tensor = torch.tensor([[concentration_value]], dtype=torch.float, device=device)

    for batch in loader:
        batch = batch.to(device)
        out, _ = model(batch.x, batch.edge_index, batch.batch, concentration_tensor)
        all_pred.append(out.squeeze(-1).cpu())
        all_target.append(get_graph_targets(batch).cpu())

    pred = torch.cat(all_pred).numpy()
    target = torch.cat(all_target).numpy()

    return (mean_absolute_error(target, pred),
            np.sqrt(mean_squared_error(target, pred)),
            r2_score(target, pred))


